def hitung_total(harga, jumlah, diskon=0):
    return harga * jumlah * (1 - diskon / 100)

while True:
    harga = float(input("\nMasukkan harga barang: "))
    jumlah = int(input("Masukkan jumlah barang: "))
    diskon = float(input("Masukkan diskon (%): "))

    total = hitung_total(harga, jumlah, diskon)
    print(f"Total belanja = Rp{total:,.2f}")

    lagi = input("Hitung lagi? (y/n): ").lower()
    if lagi != "y":
        break

