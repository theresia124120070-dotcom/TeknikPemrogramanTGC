# Challenge 2: Class Survey

from abc import ABC, abstractmethod

class Survey(ABC):
    @abstractmethod
    def processing(self):
        pass
        
class SeismicSurvey(Survey):
    def processing(self):
        print("Processing Seismic Data: applying filtering and stacking...")

class GravitySurvey(Survey):
    def processing(self):
        print("Processing Gravity Data: applying upward continuation...")
        
class MagnetikSurvey(Survey):
    def processing(self):
        print("Processing Magnetic Data: performing anomaly mapping...")

# ======== Uji Program ========
surveys = [SeismicSurvey(), GravitySurvey(), MagnetikSurvey()]

print("\n=== Processing Semua Survey ===")
for s in surveys:
    s.processing()
