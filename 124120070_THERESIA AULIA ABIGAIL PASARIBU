import locale

try:
    locale.setlocale(locale.LC_ALL, "id_ID.UTF-8")
except locale.Error:

    locale.setlocale(locale.LC_ALL, "")


class Belanja:
    """Kelas untuk menghitung total belanja dengan diskon"""

    def __init__(self, harga: int, jumlah: int, diskon: int = 0):
        if harga < 0 or jumlah < 0 or diskon < 0:
            raise ValueError("Harga, jumlah, dan diskon tidak boleh negatif.")

        self.harga = harga
        self.jumlah = jumlah
        self.diskon = diskon

    def hitung_total(self) -> int:
        total = self.harga * self.jumlah
        if self.diskon > 0:
            total -= total * (self.diskon / 100)
        return int(total)

    def format_rupiah(self, angka: int) -> str:
        try:
            return locale.currency(angka, grouping=True, symbol="Rp ")
        except Exception:
            return f"Rp {angka:,}"  

    def ringkasan(self) -> str:
        return (
            f"Harga Barang : {self.format_rupiah(self.harga)}\n"
            f"Jumlah       : {self.jumlah}\n"
            f"Diskon       : {self.diskon}%\n"
            f"---------------------------------\n"
            f"Total Belanja: {self.format_rupiah(self.hitung_total())}\n"
        )


def main():
    print("=== Program Kasir Belanja Sederhana ===\n")
    try:
        harga = int(input("Masukkan harga barang (Rp): "))
        jumlah = int(input("Masukkan jumlah barang    : "))
        diskon_input = input("Masukkan diskon (%)       : ")

        diskon = int(diskon_input) if diskon_input.strip() else 0

        belanja = Belanja(harga, jumlah, diskon)
        print("\n" + belanja.ringkasan())

    except ValueError as e:
        print(f"[ERROR] Input tidak valid: {e}")


if __name__ == "__main__":
    main()


