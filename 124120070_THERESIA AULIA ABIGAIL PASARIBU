# Challenge: Normalisasi Data TWT
import csv

filename = "data_twt.txt"  
data = []

try:
    with open(filename, mode="r") as file:
        reader = csv.DictReader(file)
        for row in reader:
            try:
                shot = int(row["shot"])
                receiver = int(row["receiver"])
                twt = float(row["twt"])
                data.append({"shot": shot, "receiver": receiver, "twt": twt})
            except ValueError:
                print("⚠️  Peringatan: Baris data tidak valid dan dilewati:", row)
except FileNotFoundError:
    print("❌ File tidak ditemukan! Pastikan file data_twt.txt tersedia.")
    exit()

try:
    twt_values = [d["twt"] for d in data]
    t_min = min(twt_values)
    t_max = max(twt_values)

    for d in data:
        d["twt_norm"] = round((d["twt"] - t_min) / (600 - t_min), 4)

except Exception as e:
    print("❌ Terjadi error saat proses normalisasi:", e)
    exit()

output_file = "data_twt_normalisasi.txt"

with open(output_file, mode="w", newline="") as file:
    fieldnames = ["shot", "receiver", "twt", "twt_norm"]
    writer = csv.DictWriter(file, fieldnames=fieldnames)
    writer.writeheader()
    writer.writerows(data)

print("✅ Data berhasil dinormalisasi dan disimpan ke:", output_file)
